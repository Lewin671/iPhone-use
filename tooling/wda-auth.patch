diff --git a/WebDriverAgentLib/Routing/FBUseAuthentication.h b/WebDriverAgentLib/Routing/FBUseAuthentication.h
new file mode 100644
index 0000000000000000000000000000000000000000..3bef1056e7fb43dbb7a1876117c20c3f71c8a1df
--- /dev/null
+++ b/WebDriverAgentLib/Routing/FBUseAuthentication.h
@@ -0,0 +1,55 @@
+// iPhone Use authentication. A missing credential closes both services.
+// Copyright (c) 2026 Lewin671. MIT License.
+#pragma once
+#import <Foundation/Foundation.h>
+
+static inline NSString *FBUseToken(void)
+{
+  NSString *token = NSProcessInfo.processInfo.environment[@"IPHONE_USE_DEVICE_TOKEN"];
+  if (token.length != 64 || [token rangeOfCharacterFromSet:
+      [[NSCharacterSet characterSetWithCharactersInString:@"0123456789abcdef"] invertedSet]].location != NSNotFound) {
+    return nil;
+  }
+  return token;
+}
+
+static inline BOOL FBUseAuthorized(NSString *authorization)
+{
+  NSString *token = FBUseToken();
+  if (nil == token || nil == authorization) { return NO; }
+  NSData *expected = [[@"Bearer " stringByAppendingString:token] dataUsingEncoding:NSUTF8StringEncoding];
+  NSData *provided = [authorization dataUsingEncoding:NSUTF8StringEncoding];
+  if (provided.length != expected.length) { return NO; }
+  const unsigned char *a = (const unsigned char *)expected.bytes;
+  const unsigned char *b = (const unsigned char *)provided.bytes;
+  unsigned char difference = 0;
+  for (NSUInteger i = 0; i < expected.length; i++) { difference |= a[i] ^ b[i]; }
+  return difference == 0;
+}
+
+// Only a complete, bodyless GET / request can begin a screenshot stream.
+static inline BOOL FBUseStreamAuthorized(NSData *headerData)
+{
+  NSString *header = [[NSString alloc] initWithData:headerData encoding:NSUTF8StringEncoding];
+  if (nil == header) { return NO; }
+  NSArray<NSString *> *lines = [header componentsSeparatedByString:@"\r\n"];
+  if (!([lines.firstObject isEqualToString:@"GET / HTTP/1.1"] ||
+        [lines.firstObject isEqualToString:@"GET / HTTP/1.0"])) { return NO; }
+  NSMutableDictionary *fields = [NSMutableDictionary dictionary];
+  for (NSUInteger i = 1; i < lines.count; i++) {
+    NSString *line = lines[i];
+    if (line.length == 0) { continue; }
+    NSRange colon = [line rangeOfString:@":"];
+    if (colon.location == NSNotFound || colon.location == 0) { return NO; }
+    NSString *name = [line substringToIndex:colon.location];
+    if ([name rangeOfCharacterFromSet:NSCharacterSet.whitespaceAndNewlineCharacterSet].location != NSNotFound) { return NO; }
+    name = name.lowercaseString;
+    if (fields[name] != nil) { return NO; }
+    NSString *value = [[line substringFromIndex:colon.location + 1]
+                      stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+    fields[name] = value;
+  }
+  return nil == fields[@"origin"] && nil == fields[@"transfer-encoding"] &&
+    (nil == fields[@"content-length"] || [fields[@"content-length"] isEqualToString:@"0"]) &&
+    FBUseAuthorized(fields[@"authorization"]);
+}
